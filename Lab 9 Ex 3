#include <iostream>
#include <cmath>
using namespace std;

int main()
{
    double x, y, f;

    int positive = 0;
    int negative = 0;

    for (int i = 21; i <= 29; i++)
    {
        x = i / 10.0;

        for (int j = 1; j <= 12; j++)
        {
            y = j / 10.0;

            f = log(y + sqrt(abs(x - y)));

            if (f > 0)
                positive++;
            else if (f < 0)
                negative++;
        }
    }

    cout << "Dodatnih znachen: "
         << positive << endl;

    cout << "Vid'yemnih znachen: "
         << negative << endl;

    return 0;
}
