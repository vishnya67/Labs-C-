#include <iostream>
using namespace std;

int main()
{
    cout << "Tryznachni chisla:" << endl;

    for (int n = 100; n <= 999; n++)
    {
        int a = n / 100;
        int b = (n / 10) % 10;
        int c = n % 10;

        if (n == a*a*a + b*b*b + c*c*c)
        {
            cout << n << endl;
        }
    }

    return 0;
}
