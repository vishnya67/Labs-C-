#include <iostream>
using namespace std;

int main() {
    int n, m;
    double a[100][100];

    cout << "Vvedit kilkist ryadkiv i stovpciv: ";
    cin >> n >> m;

    if (n < 1 || m < 1 || n > 100 || m > 100) {
        cout << "Pomilka!";
        return 0;
    }

    cout << "Vvedit elementi masivu:\n";

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < m; j++) {
            cin >> a[i][j];
        }
    }

    double minMax = 0;

    for (int i = 0; i < n; i++) {
        double max = a[i][0];

        for (int j = 1; j < m; j++) {
            if (a[i][j] > max) {
                max = a[i][j];
            }
        }

        cout << "Maksimum ryadka " << i + 1 << " = " << max << endl;

        if (i == 0 || max < minMax) {
            minMax = max;
        }
    }

    cout << "Minimalne znachennya sered maksimalnih = " << minMax << endl;

    return 0;
}
