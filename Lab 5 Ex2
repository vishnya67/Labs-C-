#include <iostream>
#include <cmath>

using namespace std;

int main() {
    double x;
    int n;

    cout << "Введіть дійсне x: ";
    cin >> x;
    cout << "Введіть натуральне n: ";
    cin >> n;

    double y = 0.0;
    for (int k = 1; k <= n; ++k) {
        y += sin(k * x);
    }

    cout << "y = " << y << endl;

    return 0;
}
