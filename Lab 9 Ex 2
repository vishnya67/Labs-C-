#include <iostream>
#include <cmath>
#include <iomanip>
using namespace std;

int main()
{
    double x, y, f;

    cout << fixed << setprecision(4);
    cout << " x       y       f(x,y)" << endl;

    for (int i = 21; i <= 29; i++)
    {
        x = i / 10.0;

        for (int j = 1; j <= 12; j++)
        {
            y = j / 10.0;

            f = log(y + sqrt(abs(x - y)));

            cout << x << "   "
                 << y << "   "
                 << f << endl;
        }
    }

    return 0;
}
