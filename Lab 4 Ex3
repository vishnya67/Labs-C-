#include <iostream>
#include <cmath>
#include <iomanip>
using namespace std;

int main() {
    double a, b, h, x, y;

    cout << "Enter a: ";
    cin >> a;

    cout << "Enter b: ";
    cin >> b;

    cout << "Enter h: ";
    cin >> h;

    cout << "\n--------------------------------\n";
    cout << setw(12) << "x"
         << setw(18) << "Y";
    cout << "\n--------------------------------\n";

    for (x = a; x <= b; x += h) {
        y = tan(x * x) + x - 3;

        cout << setw(12) << fixed << setprecision(3) << x
             << setw(18) << y << endl;
    }

    cout << "--------------------------------\n";

    return 0;
}
